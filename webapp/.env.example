# WarcraftLogs API-Client (https://www.warcraftlogs.com/api/clients/)
# Redirect URL beim Anlegen des Clients MUSS exakt WCL_REDIRECT_URI unten
# entsprechen (inkl. Protokoll/Port/Pfad).
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_REDIRECT_URI=http://DEINE-IP-ODER-DOMAIN:3000/api/auth/callback

# Nur aendern, falls sich beim ersten echten Login zeigt, dass WCL
# User-OAuth-Tokens ueber den anderen Endpunkt erwartet (siehe README).
# WCL_API_ENDPOINT=https://www.warcraftlogs.com/api/v2/user

# Region, wie in WCL-URLs verwendet (z.B. "EU", "US")
WCL_REGION=EU

# Zone-ID/Partition fuer die aktuelle Mythic+ Season -- einmalig ermitteln,
# siehe README ("Zone-ID finden").
WCL_ZONE_ID=
WCL_PARTITION=
