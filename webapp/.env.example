# WCL Client ID/Secret are NOT configured here -- each browser enters them
# once in the app itself (onboarding screen), stored in that browser only,
# not in a config file.

# NEXT_PUBLIC_ prefix is required because this is a static export with no
# server -- Next inlines these values into the browser bundle at build
# time; a plain (unprefixed) process.env wouldn't be available at runtime.
# Not secret: zone ID/partition/region are public WCL season info, the
# same numbers shown on the WCL website itself.

# Region as used in WCL URLs (e.g. "EU", "US")
NEXT_PUBLIC_WCL_REGION=EU

# Zone ID/partition for the current Mythic+ season -- see README ("Find the
# current Mythic+ season's zone ID").
NEXT_PUBLIC_WCL_ZONE_ID=
NEXT_PUBLIC_WCL_PARTITION=
